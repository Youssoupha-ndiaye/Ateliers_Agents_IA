OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
MAX_STEPS=12

# --- Serveur MCP du catalogue : "stdio" (lancé par l'agent) ou "http" (serveur lancé à part) ---
MCP_TRANSPORT=stdio
MCP_HTTP_URL=http://127.0.0.1:8000/mcp

# --- Google : ajoutez vos propres fichiers d'identifiants OAuth dans secrets/ ---
# Remplacez ces chemins si vos fichiers portent un autre nom. Ne publiez jamais leur contenu.
GOOGLE_CLIENT_SECRET=secrets/client_secret.json
GOOGLE_TOKEN=secrets/token.json
# Remplacez ******** par l'adresse e-mail de votre compte Google de test.
AGENCY_EMAIL=********


# --- Agendas des conseillers : nom=calendarId ---
# Remplacez chaque ******** par l'identifiant réel de l'agenda correspondant.
# Pour générer les agendas et obtenir leurs identifiants, lancez `python agent/setup_calendars.py`.

CONSEILLERS=Awa=********,Moussa=********,Fatou=********